{
  "name": "newtonite-ops",
  "version": "1.0.0",
  "scripts": {
    "dev": "node scripts/ensure-db.js && node --watch src/server.js",
    "build": "vite build",
    "start": "node scripts/ensure-db.js && node src/server.js",
    "migrate": "prisma db push --accept-data-loss",
    "seed": "node prisma/seed.js",
    "test": "prisma db push --accept-data-loss && node prisma/seed.js && jest --runInBand --forceExit",
    "db:start": "./node_modules/@embedded-postgres/darwin-x64/native/bin/pg_ctl -D ./.pgdata -l ./.pgdata/logfile start",
    "db:stop": "./node_modules/@embedded-postgres/darwin-x64/native/bin/pg_ctl -D ./.pgdata stop",
    "db:status": "./node_modules/@embedded-postgres/darwin-x64/native/bin/pg_ctl -D ./.pgdata status"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "vite": "^5.4.21"
  }
}
