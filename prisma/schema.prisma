datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int             @id @default(autoincrement())
  name         String
  email        String          @unique
  passwordHash String          @map("password_hash")
  memberships  Membership[]
  assignedItems WorkItem[]     @relation("Assignee")
  createdItems WorkItem[]      @relation("Creator")
  activityEvents ActivityEvent[]

  @@map("users")
}

model Team {
  id          Int          @id @default(autoincrement())
  name        String
  memberships Membership[]
  workItems   WorkItem[]

  @@map("teams")
}

model Membership {
  userId Int    @map("user_id")
  teamId Int    @map("team_id")
  role   String // 'viewer', 'member', 'lead', 'admin'
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@map("memberships")
}

model WorkItem {
  id             Int             @id @default(autoincrement())
  title          String
  description    String          @default("")
  type           String          // 'incident', 'customer_issue', 'payment', 'compliance', 'task'
  priority       String          @default("normal") // 'low', 'normal', 'high', 'urgent'
  status         String          @default("open") // 'open', 'in_progress', 'awaiting_approval', 'resolved', 'closed'
  teamId         Int             @map("team_id")
  assigneeId     Int?            @map("assignee_id")
  createdById    Int             @map("created_by")
  dueDate        DateTime?       @map("due_date")
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at")
  team           Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee       User?           @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator        User            @relation("Creator", fields: [createdById], references: [id], onDelete: Restrict)
  activityEvents ActivityEvent[]

  @@index([teamId, id(sort: Desc)])
  @@index([assigneeId, id(sort: Desc)])
  @@map("work_items")
}

model ActivityEvent {
  id        Int      @id @default(autoincrement())
  itemId    Int      @map("item_id")
  userId    Int      @map("user_id")
  kind      String   // 'created', 'updated', 'claimed', 'status_changed', 'comment'
  detail    Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  item      WorkItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([itemId, id])
  @@map("activity_events")
}

model IdempotencyKey {
  key       String
  userId    Int      @map("user_id")
  response  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@id([key, userId])
  @@map("idempotency_keys")
}
